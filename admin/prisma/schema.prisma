// Admin console data model — design §2 (docs/superpowers/specs/2026-08-24-admin-console-design.md).
// Own database `admin_console` (two Prisma migration histories cannot share one DB).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                 String            @id @default(cuid())
  email              String            @unique
  displayName        String
  passwordHash       String
  disabled           Boolean           @default(false)
  mustChangePassword Boolean           @default(false)
  failedLoginCount   Int               @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdById        String?
  // TOTP 2FA (v2 design Phase 1): secret encrypted at rest (AES-256-GCM, TOTP_ENC_KEY).
  // totpSecretEnc set + totpEnabledAt null = enrolment pending verification.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  sessions           AdminSession[]
  auditEvents        AdminAuditEvent[]
  recoveryCodes      AdminRecoveryCode[]
}

model AdminRecoveryCode {
  id       String    @id @default(cuid())
  user     AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  codeHash String    // sha256 of the code; raw code shown exactly once at enrolment
  usedAt   DateTime?

  @@index([userId])
}

model AdminSession {
  id                String    @id @default(cuid())
  // sha256(token), hex. The raw token exists only in the cookie.
  tokenHash         String    @unique
  user              AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  // Set when the password succeeded but TOTP is still owed; such sessions are invalid everywhere
  // except POST /api/auth/totp until cleared (or revoked at expiry / after 5 wrong codes).
  totpPendingUntil  DateTime?
  totpFailedCount   Int       @default(0)
  ip                String
  userAgent         String

  @@index([userId])
}

model AdminLoginAttempt {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  email   String
  ip      String
  success Boolean

  @@index([email, at])
  @@index([ip, at])
}

model AdminAuditEvent {
  id      String     @id @default(cuid())
  at      DateTime   @default(now())
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?
  action  String
  detail  Json
  ip      String

  @@index([at])
}

// v2 Phase 3 — sampler history + alerting.
model MetricSnapshot {
  id    String   @id @default(cuid())
  at    DateTime @default(now())
  key   String // e.g. node.cpu.pct/<node>, ds.up/redis, cert.days/<name>
  value Float

  @@index([key, at])
  @@index([at])
}

model AlertEvent {
  id         String    @id @default(cuid())
  kind       String // node.cpu | node.mem | node.fs | ds.down | svc.down | deploy.degraded | cert.expiry
  key        String
  message    String
  lastValue  Float
  openedAt   DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, openedAt])
  @@index([key])
}
