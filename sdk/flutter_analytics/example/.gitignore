# Dart/Flutter build artifacts — never commit these for the example app.
.dart_tool/
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies

# The example is a throwaway app; its resolved lockfile is not committed
# (the SDK it depends on is a path dependency resolved fresh each run).
pubspec.lock

# Generated platform scaffolding — recreated by `flutter create .` when you run
# the example; source (lib/, test/, pubspec.yaml) is what's tracked.
/android/
/ios/
/linux/
/macos/
/windows/
/web/
.metadata
*.iml

# OS / editor cruft
.DS_Store
