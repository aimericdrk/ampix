{
  "name": "@myampix/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MyAmpix NestJS backend — ingestion, analytics queries, auth",
  "scripts": {
    "prepare": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --config jest.config.coverage.js --coverage --runInBand",
    "test:int": "jest --config test/jest-integration.config.js --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "prisma": "prisma",
    "seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@clickhouse/client": "^1.11.0",
    "@myampix/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.8.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^14.1.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@testcontainers/postgresql": "^10.24.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.0",
    "supertest": "^7.1.0",
    "testcontainers": "^10.24.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22"
  }
}