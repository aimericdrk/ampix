generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  analyst
  viewer
}

enum ProjectRole {
  owner
  admin
  analyst
  viewer
}

/**
 * Where events sent with a token get attributed: a device/browser (`client`) or your own backend
 * (`server`). Fixed at token creation and copied onto every event the token ingests, so the
 * dimension is as trustworthy as the token itself. See @myampix/contracts INGEST_SOURCES.
 */
enum IngestSource {
  client
  server
}

/**
 * §16 — the four analysis kinds a saved report / dashboard tile can hold.
 */
enum ReportKind {
  insights
  funnel
  retention
  flows
}

model Organization {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  invitations Invitation[]
  projects    Project[]

  @@map("organizations")
}

model User {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  email              String                  @unique
  passwordHash       String                  @map("password_hash")
  name               String
  totpSecret         String?                 @map("totp_secret")
  twoFactorEnabled   Boolean                 @default(false) @map("two_factor_enabled")
  createdAt          DateTime                @default(now()) @map("created_at")
  memberships        Membership[]
  refreshTokens      RefreshToken[]
  recoveryCodes      TwoFactorRecoveryCode[]
  cohorts            Cohort[]
  savedReports       SavedReport[]
  dashboards         Dashboard[]
  projectMemberships ProjectMembership[]
  createdProjects    Project[]               @relation("ProjectCreatedBy")
  hiddenUsers        HiddenUser[]            @relation("HiddenUserBy")

  @@map("users")
}

model Membership {
  userId String @map("user_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  role   Role

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@map("memberships")
}

model Invitation {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  role       Role
  token      String   @unique
  expiresAt  DateTime @map("expires_at")
  acceptedBy String?  @map("accepted_by") @db.Uuid

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Project {
  id                 String              @id @default(uuid(7)) @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  name               String
  timezone           String              @default("UTC")
  createdAt          DateTime            @default(now()) @map("created_at")
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sdkTokens          SdkToken[]
  cohorts            Cohort[]
  savedReports       SavedReport[]
  dashboards         Dashboard[]
  screenCaptures     ScreenCapture[]
  createdById        String?             @map("created_by") @db.Uuid
  createdBy          User?               @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  projectMemberships ProjectMembership[]
  revenuecatIntegration RevenueCatIntegration?
  subscriptionStates    SubscriptionState[]
  revenuecatWebhookEvents RevenueCatWebhookEvent[]
  hiddenUsers             HiddenUser[]

  @@map("projects")
}

model SdkToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  token     String       @unique
  label     String
  /// Immutable after creation — rotating a token mints a new one with the same source, and
  /// re-pointing an existing token would silently re-label events already ingested with it.
  source    IngestSource @default(client)
  /// Capability, not identity: a `server` token may additionally be allowed to erase end-user data
  /// (DELETE /ingest/users/:distinctId). Off unless asked for, and never set on a `client` token —
  /// that one ships inside the app, so it must never authorize a destructive delete.
  canErase  Boolean      @default(false) @map("can_erase")
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("sdk_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/**
 * §11 — single-use 2FA recovery codes; only argon2id hashes are ever persisted.
 */
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_recovery_codes")
}

/**
 * §16 — a saved audience definition. `definition` is validated JSON (the cohort zod schema),
 * re-validated on write AND before every run so the injection-safe engine is the only path to CH.
 */
model Cohort {
  id         String   @id @default(uuid(7)) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  name       String
  definition Json
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("cohorts")
}

/**
 * §16 — a saved query of any analysis type. `kind` selects which §14/§15 zod schema validates
 * `definition` (insights / funnel / retention / flows), both on write and before every `/run`.
 */
model SavedReport {
  id         String     @id @default(uuid(7)) @db.Uuid
  projectId  String     @map("project_id") @db.Uuid
  name       String
  kind       ReportKind
  definition Json
  createdBy  String     @map("created_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User            @relation(fields: [createdBy], references: [id])
  tiles   DashboardTile[]

  @@index([projectId])
  @@map("saved_reports")
}

/**
 * §16 — a named grid of tiles (12-column layout), each tile backed by a saved report or inline def.
 */
model Dashboard {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User            @relation(fields: [createdBy], references: [id])
  tiles   DashboardTile[]

  @@index([projectId])
  @@map("dashboards")
}

/**
 * §16 — one tile on a dashboard. References EXACTLY ONE of `savedReportId` / `inlineDefinition`
 * (enforced in the service). Grid is a fixed 12-column layout: w 1..12, h >= 1, x 0..11, x+w <= 12.
 */
model DashboardTile {
  id               String     @id @default(uuid(7)) @db.Uuid
  dashboardId      String     @map("dashboard_id") @db.Uuid
  title            String
  savedReportId    String?    @map("saved_report_id") @db.Uuid
  inlineDefinition Json?      @map("inline_definition")
  kind             ReportKind
  x                Int
  y                Int
  w                Int
  h                Int
  position         Int

  dashboard   Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  savedReport SavedReport? @relation(fields: [savedReportId], references: [id], onDelete: SetNull)

  @@index([dashboardId, position])
  @@map("dashboard_tiles")
}

model ProjectMembership {
  userId    String      @map("user_id") @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_memberships")
}

/**
 * §18 — automatic screenshot pipeline metadata. Exactly ONE image per
 * `(project_id, screen_name, app_version)` (the SDK captures each screen once per app version), so
 * this set is inherently bounded (#screens × #versions). The image BYTES live in Firebase Storage
 * (GCS); this table holds only metadata + `storage_path`, the deterministic object path in the
 * bucket (e.g. `screens/{project_id}/{screen_name}/{app_version}.jpg`). `POST /ingest/screenshots`
 * puts the bytes at that path (overwrite) and UPSERTs this row, so `captured_at` records the first
 * upload of a version and `updated_at` the last replace.
 */
model ScreenCapture {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  screenName  String   @map("screen_name")
  storagePath String   @map("storage_path")
  contentType String   @map("content_type")
  width       Int
  height      Int
  /// Logical height of the scrollable content this image covers, when the screen was taller than
  /// one viewport and the SDK stitched it. NULL means a single-viewport capture — every row that
  /// existed before full-page capture, and every screen that simply fits.
  ///
  /// The heatmap needs it to normalize a tap's `$content_y`: the image's own pixel height says how
  /// tall the picture is, not how tall the page was.
  contentHeight  Float?  @map("content_height")
  /// Logical height of one viewport — how much of `contentHeight` was visible at a time. NULL for
  /// the same reason.
  viewportHeight Float?  @map("viewport_height")
  /// Where CONTENT space starts inside a stitched image: the logical height of the fixed chrome
  /// (status bar, app bar) the first frame keeps above the scrollable. The heatmap places a tap's
  /// `$content_y` at row `content_top + $content_y`. NULL reads as 0 — exact for every capture
  /// taken before the chrome was included, which had none.
  contentTop     Float?  @map("content_top")
  appVersion  String   @map("app_version")
  imageHash   String   @map("image_hash")
  capturedAt  DateTime @default(now()) @map("captured_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, screenName, appVersion])
  @@index([projectId, screenName])
  @@map("screen_captures")
}

model RevenueCatIntegration {
  id             String    @id @default(uuid(7)) @db.Uuid
  projectId      String    @unique @map("project_id") @db.Uuid
  webhookSecret  String    @map("webhook_secret")
  apiKey         String?   @map("api_key")
  rcProjectId    String?   @map("rc_project_id")
  sandboxMode    Boolean   @default(false) @map("sandbox_mode")
  lastWebhookAt  DateTime? @map("last_webhook_at")
  backfillStatus String?   @map("backfill_status")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("revenuecat_integrations")
}

model SubscriptionState {
  id              String    @id @default(uuid(7)) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  rcAppUserId     String    @map("rc_app_user_id")
  distinctId      String?   @map("distinct_id")
  status          String
  productId       String?   @map("product_id")
  store           String?
  periodType      String?   @map("period_type")
  priceCents      Int?      @map("price_cents")
  currency        String?
  mrrCents        Int       @default(0) @map("mrr_cents")
  totalSpentCents Int       @default(0) @map("total_spent_cents")
  firstPurchaseAt DateTime? @map("first_purchase_at")
  expiresAt       DateTime? @map("expires_at")
  cancelledAt     DateTime? @map("cancelled_at")
  lastEventAt     DateTime? @map("last_event_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, rcAppUserId])
  @@index([projectId, status])
  @@index([projectId, distinctId])
  @@map("subscription_states")
}

model RevenueCatWebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  rcEventId   String    @map("rc_event_id")
  eventType   String    @map("event_type")
  rcAppUserId String?   @map("rc_app_user_id")
  payload     Json
  status      String
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, rcEventId])
  @@index([projectId, status])
  @@map("revenuecat_webhook_events")
}

/**
 * A user hidden from the audience surfaces (Users list, user profile, live feed) WITHOUT erasing
 * their events — the reversible half of the dashboard's "remove this user" action; the other half
 * is ErasureService's irreversible wipe.
 *
 * Postgres rather than ClickHouse on purpose: the set is tiny and hand-curated, it needs the
 * `hidden_by`/`hidden_at` audit fields and an un-hide, and ClickHouse here has no migration path
 * (infra/clickhouse/init.sql only runs on first container init). The read path binds the ids as a
 * `{hiddenIds:Array(String)}` param.
 *
 * `distinctId` is the CANONICAL id (contracts §17) resolved at hide time, so hiding a user by one
 * of their anon ids hides the whole merged identity.
 */
model HiddenUser {
  id         String   @id @default(uuid(7)) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  distinctId String   @map("distinct_id")
  hiddenById String?  @map("hidden_by") @db.Uuid
  hiddenAt   DateTime @default(now()) @map("hidden_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hiddenBy User?   @relation("HiddenUserBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@unique([projectId, distinctId])
  @@index([projectId])
  @@map("hidden_users")
}
