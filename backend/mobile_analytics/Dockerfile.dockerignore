# Ignore patterns for backend/mobile_analytics/Dockerfile (build context = repo root, so patterns
# are root-relative).
# Keeps host node_modules, build output, secrets, and tests out of the build context.
**/node_modules
**/dist
**/coverage
**/.env
**/.env.*
!**/.env.example
**/*.spec.ts
**/*.test.ts
backend/mobile_analytics/test
.git
**/.DS_Store
