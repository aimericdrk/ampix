NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://myampix:myampix_dev@localhost:5432/myampix
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=myampix_dev
CLICKHOUSE_DB=analytics
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev_only_change_me_dev_only_change_me
JWT_REFRESH_SECRET=dev_only_change_me_dev_only_change_yes
INGEST_MAX_BATCH=100
INGEST_MAX_BODY_KB=1024
# §18 — max size (KB) of a single automatic screenshot upload (JPEG). Default 512.
SCREENSHOT_MAX_KB=512
# §18 — Firebase Storage (GCS) bucket the screenshot BYTES are written to; Postgres keeps only
# metadata + the object path. When unset, the app uses an in-memory fake store (dev/test) and logs a
# warning (images are NOT persisted). Credentials come from GOOGLE_APPLICATION_CREDENTIALS (a
# service-account JSON path) or Application Default Credentials. NEVER commit a service-account key.
FIREBASE_STORAGE_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Auth & TOTP 2FA (shared contracts §11)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
MFA_TOKEN_TTL=300
TOTP_ISSUER=MyAmpix
# 32-byte key (64 hex chars) for AES-256-GCM of TOTP secrets — dev-only value, generate a fresh
# one for real environments (e.g. `openssl rand -hex 32`).
TOTP_ENC_KEY=9d3383ee2d0de7feb67f8e677e9c6e676b217df5aeff883d13783788db4b3d46
# Refresh cookie Secure flag. Dev default is false (plain HTTP on localhost). NODE_ENV=production
# REQUIRES this to be true — the app refuses to boot with COOKIE_SECURE=false in production, since
# a false value would let the refresh cookie be sent over plaintext HTTP.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# §20 — pino base log level: fatal|error|warn|info|debug|trace|silent. Default info. At info,
# successful (2xx/3xx) request logs are suppressed (they log at debug); app logs and 4xx/5xx
# request logs still surface. Set debug/trace to see successful-request logs.
LOG_LEVEL=info
