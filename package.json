{
  "name": "myampix",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted Mixpanel-class product analytics platform (monorepo root)",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "@radix-ui/react-dismissable-layer": "^1.1.15",
      "@radix-ui/react-focus-scope": "^1.1.12"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:functional": "bash scripts/functional-test.sh",
    "dev": "bash scripts/dev.sh",
    "seed": "pnpm --filter @myampix/mobile-analytics exec prisma db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "ship": "bash scripts/k8s/ship.sh",
    "k8s:lint": "bash scripts/k8s/lint.sh",
    "k8s:local": "bash scripts/k8s/local.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
