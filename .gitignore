# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
graphify-out/

# Generated Prisma client (mobile_purchase uses a package-local output so it never
# clobbers mobile_analytics' shared @prisma/client — see backend/mobile_purchase/prisma/schema.prisma)
backend/mobile_purchase/generated/
# Admin console: package-local Prisma client + Next build output
admin/generated/
admin/.next/

# Environment — real env files never committed; the example is
.env
.env.*
!.env.example

# Logs
*.log
pnpm-debug.log*

# OS / editors
.DS_Store
.idea/
.vscode/

# Flutter/Dart (sdk/ sub-project)
.dart_tool/
sdk/**/pubspec.lock
.flutter-plugins*

# Local tooling (machine-local, never committed)
CLAUDE.md
images/
.claude/
.claude-flow/
.agents/
.swarm/
.firebase/
.superpowers/

# Firebase / GCP service-account keys and other credential files (NEVER commit)
google-service-account.json
**/google-service-account.json
*-service-account*.json
*.serviceaccount.json
ruvector.db
# Kubernetes / VPS deploy — real secrets and per-environment values (NEVER commit)
infra/k8s/secrets/*
!infra/k8s/secrets/*.example
infra/values.prod.yaml
infra/.env.prod
!infra/.env.prod.example
