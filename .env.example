# MyAmpix backend environment — local development values.
# Copy to .env and adjust if needed. .env is gitignored; this example is committed.
# Source of truth: docs/superpowers/specs/2026-07-02-shared-contracts.md §3.

NODE_ENV=development
PORT=8088

# PostgreSQL (metadata: orgs, users, projects, tokens…)
DATABASE_URL=postgresql://myampix:myampix_dev@localhost:5432/myampix

# ClickHouse (event store)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=myampix_dev
CLICKHOUSE_DB=analytics

# Redis (rate limiting, token cache, BullMQ)
REDIS_URL=redis://localhost:6379

# JWT secrets — min 32 chars; the app refuses to boot without them outside NODE_ENV=test.
# Production values live in Google Secret Manager, never in files.
JWT_ACCESS_SECRET=dev_only_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=dev_only_refresh_secret_min_32_chars_long!

# Ingestion limits
INGEST_MAX_BATCH=100
INGEST_MAX_BODY_KB=1024
INGEST_RATE_LIMIT_PER_MIN=10000 # optional; backend falls back to this default when unset

# Self-service registration. 'false' closes the instance: POST /api/v1/auth/signup answers 403 and
# the dashboard hides its register page. Create accounts manually instead:
#   pnpm --filter @myampix/mobile-analytics account:create -- --email you@example.com --name "You"
SIGNUP_ENABLED=true
