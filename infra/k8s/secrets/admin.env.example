# Secret env for the admin console → Secret myampix-admin (scripts/k8s/secrets.sh).
# Copy to admin.env (gitignored), fill every CHANGE_ME.
# Schema: admin/src/lib/env.ts · seed: admin/scripts/migrate.mjs

# Own database on the shared host Postgres (password = POSTGRES_PASSWORD from infra/.env.prod).
# The migrate job creates the admin_console database automatically if it does not exist.
DATABASE_URL=postgresql://myampix:CHANGE_ME@postgres:5432/admin_console
# Probe targets (same credentials as the backend services' env files):
ANALYTICS_DATABASE_URL=postgresql://myampix:CHANGE_ME@postgres:5432/myampix
PURCHASE_DATABASE_URL=postgresql://mobile_purchase:CHANGE_ME@mobile-purchase-postgres:5433/mobile_purchase
CLICKHOUSE_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
# Encrypts TOTP 2FA secrets at rest (32 bytes, base64 or hex). Unset ⇒ 2FA enrolment unavailable.
#   openssl rand -base64 32
TOTP_ENC_KEY=CHANGE_ME
# Optional: alert webhook (Slack/Discord-compatible JSON POST on alert open/resolve).
#ALERT_WEBHOOK_URL=
# Default account, seeded ONLY while the user table is empty; a password change is forced at first
# login — rotate immediately, then you may delete these two lines and re-run secrets.sh.
ADMIN_DEFAULT_EMAIL=CHANGE_ME@example.com
# >= 12 chars:  openssl rand -base64 24
ADMIN_DEFAULT_PASSWORD=CHANGE_ME
