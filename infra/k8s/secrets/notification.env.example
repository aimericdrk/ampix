# notification-sender secrets → Secret myampix-notification (scripts/k8s/secrets.sh).
# Copy to notification.env and fill in. NEVER commit the filled file (infra/k8s/secrets/* is gitignored).
#
# The Firebase service-account JSON is NOT here — it goes into its own Secret:
#   SECRET_NAME=myampix-notification-google scripts/k8s/firebase-credentials.sh /path/to/service-account.json

# Full connection string, including credentials and options (e.g. mongodb+srv://user:pass@host/?retryWrites=true).
MONGODB_URI=CHANGE_ME
MONGODB_DATABASE=atclub
# HMAC key the callers sign X-Timestamp with (src/notification/guards/server-auth.guard.ts).
# Must match the value configured in the calling backend.  openssl rand -hex 32
SERVER_AUTH_SECRET=CHANGE_ME
