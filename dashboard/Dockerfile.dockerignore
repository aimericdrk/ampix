**/dist
**/coverage
**/.env
**/.env.*
!**/.env.example
dashboard/e2e
dashboard/e2e-functional
dashboard/test-results
dashboard/playwright-report
**/*.test.ts
**/*.test.tsx
.git
**/.DS_Store
